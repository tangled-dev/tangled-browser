+// Tangled: the millix wallet is exposed as a built-in, pinned toolbar action.
+// It has no files; its icon and click handling live in
+// ExtensionActionViewModel.
+void ToolbarActionsModel::AddMillixExtension() {
+  if (extension_registry_->GetExtensionById(
+          extensions::Extension::MILLIX_EXTENSION_ID,
+          extensions::ExtensionRegistry::EVERYTHING)) {
+    return;
+  }
+
+  base::DictValue manifest;
+  manifest.Set(extensions::manifest_keys::kName, "millix");
+  manifest.Set(extensions::manifest_keys::kManifestVersion, 3);
+  manifest.Set(extensions::manifest_keys::kVersion, "0.1");
+  manifest.Set(extensions::manifest_keys::kDescription,
+               "millix wallet extension");
+  manifest.Set(extensions::manifest_keys::kAction, base::DictValue());
+
+  std::u16string error;
+  scoped_refptr<const extensions::Extension> millix_extension =
+      extensions::Extension::Create(
+          base::FilePath(), extensions::mojom::ManifestLocation::kInternal,
+          manifest, extensions::Extension::WAS_INSTALLED_BY_DEFAULT,
+          extensions::Extension::MILLIX_EXTENSION_ID, &error);
+  if (!millix_extension) {
+    LOG(ERROR) << "Unable to create millix extension: " << error;
+    return;
+  }
+
+  extensions::ExtensionRegistrar::Get(profile_)->AddExtension(millix_extension);
+  extension_prefs_->SetIsIncognitoEnabled(
+      extensions::Extension::MILLIX_EXTENSION_ID, true);
+  auto stored_pinned_actions = extension_prefs_->GetPinnedExtensions();
+  if (!std::ranges::contains(stored_pinned_actions,
+                             extensions::Extension::MILLIX_EXTENSION_ID)) {
+    stored_pinned_actions.push_back(extensions::Extension::MILLIX_EXTENSION_ID);
+    extension_prefs_->SetPinnedExtensions(stored_pinned_actions);
+  }
 }
 
